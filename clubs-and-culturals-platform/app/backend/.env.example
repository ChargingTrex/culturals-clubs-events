# ---- Integration mode: `local` (standalone) or `platform` (portal SSO) ----
# Per API_Standards_Integration_Contract §2. Switching modes changes only where
# the token comes from and which key validates it. Nothing downstream changes.
INTEGRATION_MODE=local

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is the target database (AGENT_PROMPT §2). Leave DATABASE_URL unset
# to fall back to SQLite for a quick local demo; the venue exclusion constraint
# is Postgres-only and is skipped on SQLite (see events/migrations).
# DATABASE_URL=postgres://culturals:culturals@localhost:5432/culturals

# ---- Platform mode only ----
PLATFORM_ISSUER=https://portal.college.edu
PLATFORM_JWKS_URL=https://portal.college.edu/.well-known/jwks.json
PLATFORM_AUDIENCE=clubs

# ---- Institution config (Identity_Login_Shared_Data §3.4: never hard-coded) ----
PRN_REGEX=^[0-9]{2}[A-Z]{2,4}[0-9]{3,5}$

# ---- QR signing keys ----
# Comma-separated `key_id:secret`, each secret 32+ bytes. The active id signs;
# every listed id still verifies, so a rotation does not invalidate passes or
# certificates already issued. Never derived from DJANGO_SECRET_KEY.
# QR_SIGNING_KEYS=v1:replace-with-a-32-byte-random-secret-value
# QR_ACTIVE_KEY_ID=v1
CERTIFICATE_VERIFY_BASE=http://localhost:5173/verify

# ---- Domain thresholds (AGENT_PROMPT §9: open questions, so configurable) ----
VC_BUDGET_THRESHOLD=50000
RECEIPT_THRESHOLD=5000
VENUE_BUFFER_MINUTES=0
CONTINGENCY_PERCENT=8

# ---- Approval chain ----
# DEVIATION from AGENT_PROMPT §2 ("Dean only, no faculty advisor step"):
# cultural_society is an extra pre-Dean gate requested by the product owner.
# Set to `dean` alone to restore the documented chain.
APPROVAL_CHAIN=cultural_society,dean

EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=culturals@college.edu

# Set EMAIL_BACKEND to override the default (console when DEBUG=1, SMTP otherwise).
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

CELERY_BROKER_URL=redis://localhost:6379/0
# Run tasks inline instead of through a worker. Defaults to the DEBUG value;
# set to 1 on any host without a Celery worker (Vercel).
# CELERY_TASK_ALWAYS_EAGER=1

# ---- Browser origins ----
# Comma-separated. CORS: where the frontend is served from. CSRF: only matters
# for cookie-authenticated pages (Django admin); the API is bearer-token.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF_TRUSTED_ORIGINS=https://culturals-api.vercel.app

# ---- Demo mode ----
# Disables the login step for a walkthrough: exposes /auth/demo/<persona>, which
# mints a REAL token with no password, and serves one page per view at /demo/.
# Permission checks all still run, so a 403 in the demo is a genuine 403.
# Refuses to start with DEBUG=0. Never set this on a shared or public host.
DEMO_MODE=1

# =============================================================================
# Vercel test hosting (docs/HOSTING.md). Set these in the Vercel project's
# Environment Variables, never in a committed file. DEBUG must be 0 on a public
# host, which is also why DEMO_MODE must be 0 there (it refuses DEBUG=0).
# =============================================================================
# DJANGO_SECRET_KEY=<50+ random characters: python -c "import secrets;print(secrets.token_urlsafe(50))">
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=<project>.vercel.app,.vercel.app
# DATABASE_URL=postgres://<user>:<password>@<host>.neon.tech/<db>   (Neon; query string is ignored, SSL is negotiated)
# QR_SIGNING_KEYS=v1:<32+ random bytes: python -c "import secrets;print(secrets.token_urlsafe(48))">
# QR_ACTIVE_KEY_ID=v1
# CORS_ALLOWED_ORIGINS=https://<react-frontend>.vercel.app,https://<walkthrough>.netlify.app
# CSRF_TRUSTED_ORIGINS=https://<project>.vercel.app
# CELERY_TASK_ALWAYS_EAGER=1
# CELERY_BROKER_URL=memory://              (no broker exists; eager mode never touches it)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend   (mail goes to the function log)
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# DEFAULT_FROM_EMAIL=culturals@college.edu
# INTEGRATION_MODE=local
# DEMO_MODE=0
# CERTIFICATE_VERIFY_BASE=https://<react-frontend>.vercel.app/verify
