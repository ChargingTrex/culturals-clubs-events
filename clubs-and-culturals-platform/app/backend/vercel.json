{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash build_files.sh",
  "outputDirectory": "staticfiles_build",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/v1/jobs/apply-due-terms", "schedule": "5 0 * * *" },
    { "path": "/api/v1/jobs/rollup-scans", "schedule": "0 3 * * *" },
    { "path": "/api/v1/jobs/purge-external", "schedule": "10 3 * * *" },
    { "path": "/api/v1/jobs/flag-dormant", "schedule": "20 3 * * *" },
    { "path": "/api/v1/jobs/escalate-sla", "schedule": "0 * * * *" }
  ]
}
